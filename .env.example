# Copy this file to .env.local and set a long random SESSION_SECRET.
SESSION_SECRET=replace-with-a-long-random-string

# local (default) or supabase
DATA_PROVIDER=local

# Used only when DATA_PROVIDER=supabase. The adapter does not map tables yet.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Demo access codes are generated on first run, printed in the server log,
# and saved to data/initial-codes.txt. They are not listed here.
